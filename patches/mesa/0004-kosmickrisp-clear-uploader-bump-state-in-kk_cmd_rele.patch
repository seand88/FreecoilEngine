From 1b0e0fb72701e509a67fbc92bcfef1d8bf281af8 Mon Sep 17 00:00:00 2001
From: benbreen <8338320+benbreen@users.noreply.github.com>
Date: Wed, 22 Jul 2026 21:00:41 +0100
Subject: [PATCH 04/11] kosmickrisp: clear uploader bump state in
 kk_cmd_release_resources

NULL the uploader bo/offset when the BO list is freed so a resubmitted command buffer (e.g. WSI swapchain blit) does not keep bumping into a BO already returned to the pool (stale-descriptor rendering corruption).
---
 src/kosmickrisp/vulkan/kk_cmd_buffer.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index 31c2e49e..8a69b666 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -41,6 +41,17 @@ kk_cmd_release_resources(struct kk_device *dev, struct kk_cmd_buffer *cmd)
 
    kk_cmd_pool_free_bo_list(pool, &cmd->uploader.bos);
 
+   /* The bump state must die with the BO list: a command buffer submitted
+    * again without an intervening reset (e.g. WSI swapchain blit command
+    * buffers, recorded once and resubmitted every present) re-enters here
+    * with uploader.bo pointing into a BO just returned to the pool. Leaving
+    * it dangling makes kk_pool_alloc carve new allocations out of memory the
+    * pool may already have handed to another command buffer, so later
+    * uploads overwrite live descriptor sets and root tables of in-flight
+    * work (visible as stale-descriptor rendering corruption). */
+   cmd->uploader.bo = NULL;
+   cmd->uploader.offset = 0;
+
    /* Release all BOs used as descriptor buffers for submissions */
    util_dynarray_foreach(&cmd->large_bos, struct kk_bo *, bo) {
       kk_destroy_bo(dev, *bo);
