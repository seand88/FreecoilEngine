From 8e6d5db1ef1f6a8bbd5d81983b6932b45ee7cb7b Mon Sep 17 00:00:00 2001
From: benbreen <8338320+benbreen@users.noreply.github.com>
Date: Wed, 22 Jul 2026 21:00:41 +0100
Subject: [PATCH 05/11] kosmickrisp: order pre_gfx heap work behind the
 previous submission

Add a per-queue order_event: pre_gfx of submission N waits value N-1, main of submission N signals value N, so a submission's heap reset/unroll cannot run while the previous submission's draws still read the shared heap.
---
 src/kosmickrisp/vulkan/kk_queue.c | 13 +++++++++++++
 src/kosmickrisp/vulkan/kk_queue.h | 11 +++++++++++
 2 files changed, 24 insertions(+)

diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 95a97f90..124f7959 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -37,6 +37,11 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
       encoder->main.wait_fence = true;
    }
 
+   /* pre_gfx work of this submission (heap reset, unroll) must not run until
+    * the previous submission's main work has finished with the shared heap. */
+   mtl_encode_wait_for_event(encoder->pre_gfx.cmd_buffer, queue->order_event,
+                             queue->order_value);
+
    for (struct vk_sync_wait *wait = submit->waits,
                             *end = submit->waits + submit->wait_count;
         wait != end; ++wait) {
@@ -81,6 +86,11 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
    /* Steal the last fence to chain with the next submission */
    if (util_dynarray_num_elements(&encoder->main.fences, mtl_fence *) > 0)
       queue->wait_fence = util_dynarray_pop(&encoder->main.fences, mtl_fence *);
+
+   queue->order_value++;
+   mtl_encode_signal_event(encoder->main.cmd_buffer, queue->order_event,
+                           queue->order_value);
+
    kk_encoder_submit(encoder);
 
    return VK_SUCCESS;
@@ -119,6 +129,9 @@ kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
    if (result != VK_SUCCESS)
       return result;
 
+   queue->order_event = mtl_new_event(dev->mtl_handle);
+   queue->order_value = 0;
+
    queue->main.mtl_handle =
       mtl_new_command_queue(dev->mtl_handle, KK_MAX_CMD_BUFFERS);
    mtl_command_queue_add_residency_set(queue->main.mtl_handle,
diff --git a/src/kosmickrisp/vulkan/kk_queue.h b/src/kosmickrisp/vulkan/kk_queue.h
index 0633559d..06a8901b 100644
--- a/src/kosmickrisp/vulkan/kk_queue.h
+++ b/src/kosmickrisp/vulkan/kk_queue.h
@@ -25,6 +25,17 @@ struct kk_queue {
    } main, pre_gfx;
 
    mtl_fence *wait_fence;
+
+   /* Cross-submission ordering for the pre_gfx queue. Main chains to the
+    * previous submission through wait_fence, but pre_gfx command buffers had
+    * no such link: a submission's pre_gfx work (device heap reset, geometry
+    * unroll) could run concurrently with the PREVIOUS submission's rendering,
+    * resetting/reallocating the shared geometry heap while in-flight draws
+    * still read their unrolled indices. pre_gfx of submission N waits for
+    * this event at value N-1; main of submission N signals value N at its
+    * end. */
+   mtl_event *order_event;
+   uint64_t order_value;
 };
 
 static inline struct kk_device *
